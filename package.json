{
  "name": "wkw-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "«Чего хочет Красноярск?» — монорепозиторий (web + api)",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build -w web",
    "build:api": "npm run build -w api",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm run lint -w web",
    "lint:api": "npm run lint -w api",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "npm run typecheck -w web",
    "typecheck:api": "npm run typecheck -w api"
  }
}
