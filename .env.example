# =========================================================
# «Чего хочет Красноярск?» — пример переменных окружения
# Скопируйте этот файл в .env и при необходимости измените значения.
# Реальные секреты в репозиторий не коммитятся (.env в .gitignore).
# =========================================================

# --- General ---
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_DB=wkw
POSTGRES_USER=wkw
POSTGRES_PASSWORD=wkw_dev_password
POSTGRES_PORT=5432
# Строка подключения используется backend-сервисами (host = имя сервиса в compose)
DATABASE_URL=postgresql://wkw:wkw_dev_password@postgres:5432/wkw?schema=public

# --- MinIO (S3-совместимое хранилище для разработки) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- S3 (используется приложением; для dev указывает на MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET=wkw-media
S3_REGION=ru-central1
# MinIO требует path-style адресацию бакета (bucket в пути, не в поддомене).
S3_FORCE_PATH_STYLE=true

# --- Порты приложений ---
API_PORT=3000
WEB_PORT=5173

# --- Nginx (reverse proxy для локального окружения) ---
NGINX_PORT=8080

# --- Public map (MapLibre GL + OpenFreeMap, no API key) ---
# Basemap provider is configured in web/src/shared/map/providers/

# --- Административная авторизация (E03) ---
# TTL административной сессии в часах (техническая настройка, не бизнес-логика).
ADMIN_SESSION_TTL_HOURS=24
# Bootstrap-администратор: используется ТОЛЬКО скриптом `npm run admin:create -w api`.
# Не коммить реальные секреты. В локальном .env можно задать dev-значения.
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
